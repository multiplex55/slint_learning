import { ScrollView } from "std-widgets.slint";
import { DashboardPage } from "pages/dashboard.slint";
import { LayoutsPage } from "pages/layouts.slint";
import { ButtonsAndInputsPage } from "pages/buttons-and-inputs.slint";
import { ListsAndModelsPage } from "pages/lists-and-models.slint";
import { StylingAndThemesPage } from "pages/styling-and-themes.slint";
import { WindowManagementPage } from "pages/window-management.slint";
import { CrossPageDataPage } from "pages/cross-page-data.slint";
import { PerformanceAndBestPracticesPage } from "pages/performance-and-best-practices.slint";
import { PlaygroundPage } from "pages/playground.slint";

export { DetailsWindow } from "windows/details-window.slint";
export { InspectorWindow } from "windows/inspector-window.slint";
export { AboutWindow } from "windows/about-window.slint";

import { DemoListRowData, ThemeOptionData, PatternNoteData, ComponentMetaData } from "pages/demo-data.slint";

component NavigationButton inherits Rectangle {
    in property <string> label;
    in property <string> category;
    in property <bool> selected;
    callback clicked;
    min-height: 68px;
    border-radius: 12px;
    background: selected ? #dbeafe : #ffffff;
    border-width: 1px;
    border-color: selected ? #60a5fa : #d7dde5;
    TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
    VerticalLayout {
        padding: 12px;
        spacing: 4px;
        Text { text: label; font-size: 16px; font-weight: 700; color: #102a43; }
        Text { text: category; color: #52606d; font-size: 12px; }
    }
}

export component AppWindow inherits Window {
    width: 1320px;
    height: 900px;
    title: "Slint Learning Workspace";
    background: #edf2f7;

    in-out property <int> current-page: 0;
    in property <string> page-title: "Dashboard";
    in property <string> page-description: "";
    in property <string> page-category: "";
    in property <string> page-notes: "";
    in property <string> shared-status: "";
    in property <string> dashboard-status-summary: "";
    in property <string> learner-name: "";
    in property <string> cohort-name: "";
    in property <string> theme-name: "";
    in property <string> shared-note-text: "";
    in property <string> shared-note-status: "";
    in property <int> shared-progress-value: 0;
    in property <string> shared-progress-label: "";
    in property <string> dashboard-preview-text: "";
    in property <string> editor-hint: "";
    in property <string> sync-notes: "";
    in property <string> window-demo-text: "";
    in property <string> window-demo-details-status: "";
    in property <string> window-demo-inspector-status: "";
    in property <string> window-demo-about-status: "";
    in property <string> window-demo-child-feedback: "";
    in property <string> window-demo-lifecycle-status: "";
    in property <string> window-demo-instructional-text: "";
    in property <string> window-demo-prepared-preview: "";
    in property <[DemoListRowData]> list-demo-rows;
    in property <int> selected-list-demo-index: 0;
    in property <string> list-demo-summary: "";
    in property <[ThemeOptionData]> theme-demo-options;
    in property <string> theme-demo-selected-id: "";
    in property <string> theme-demo-selected-label: "";
    in property <string> theme-demo-selected-summary: "";
    in property <string> theme-demo-accent-hex: "#2563eb";
    in property <[PatternNoteData]> performance-pattern-notes;
    in property <[ComponentMetaData]> component-registry;
    in property <string> component-registry-summary: "";
    in property <int> visible-component-count: 0;
    in property <bool> playground-show-details: true;
    in property <bool> playground-loading: false;
    in property <string> playground-loading-label: "";
    in property <int> total-pages: 0;

    callback request-page(int);
    callback dashboard-action(string);
    callback update-shared-note(string);
    callback adjust-shared-progress(int);
    callback reset-cross-page-demo();
    callback update-window-demo-text(string);
    callback open-details-window();
    callback open-inspector-window();
    callback hide-inspector-window();
    callback spawn-about-window();
    callback close-details-window();
    callback close-all-demo-windows();
    callback select-list-demo-item(int);
    callback refresh-list-demo();
    callback select-theme-demo(string);
    callback toggle-playground-details();
    callback toggle-playground-loading();

    VerticalLayout {
        padding: 18px;
        spacing: 14px;

        Rectangle {
            background: #ffffff;
            border-radius: 18px;
            border-width: 1px;
            border-color: #d9e2ec;
            min-height: 112px;
            HorizontalLayout {
                padding: 18px;
                spacing: 18px;
                VerticalLayout {
                    spacing: 6px;
                    Text { text: "Slint Demo Shell"; font-size: 30px; font-weight: 800; color: #102a43; }
                    Text { text: "An intentionally instructional desktop shell that hosts focused demo pages and keeps the navigation model testable in Rust."; wrap: word-wrap; color: #486581; }
                }
                Rectangle {
                    min-width: 320px;
                    background: #f8fafc;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: #d9e2ec;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 4px;
                        Text { text: "Shared teaching context"; font-size: 14px; font-weight: 700; color: #334e68; }
                        Text { text: shared-status; wrap: word-wrap; color: #52606d; }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 14px;
            Rectangle {
                min-width: 280px;
                background: #f8fbff;
                border-radius: 18px;
                border-width: 1px;
                border-color: #d9e2ec;
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Text { text: "Navigation"; font-size: 24px; font-weight: 800; color: #102a43; }
                    Text { text: "Each entry maps to a Rust `PageId` so ordering, labels, and grouping stay easy to test."; wrap: word-wrap; color: #52606d; }
                    ScrollView {
                        viewport-width: 240px;
                        viewport-height: 620px;
                        VerticalLayout {
                            spacing: 10px;
                            NavigationButton { label: "Dashboard"; category: "Getting Started"; selected: current-page == 0; clicked => { root.request-page(0); } }
                            NavigationButton { label: "Layouts"; category: "Layout Patterns"; selected: current-page == 1; clicked => { root.request-page(1); } }
                            NavigationButton { label: "Buttons and Inputs"; category: "Interactive Widgets"; selected: current-page == 2; clicked => { root.request-page(2); } }
                            NavigationButton { label: "Lists and Models"; category: "Interactive Widgets"; selected: current-page == 3; clicked => { root.request-page(3); } }
                            NavigationButton { label: "Styling and Themes"; category: "Presentation"; selected: current-page == 4; clicked => { root.request-page(4); } }
                            NavigationButton { label: "Window Management"; category: "Application Shell"; selected: current-page == 5; clicked => { root.request-page(5); } }
                            NavigationButton { label: "Cross-page Data"; category: "Application Shell"; selected: current-page == 6; clicked => { root.request-page(6); } }
                            NavigationButton { label: "Performance and Best Practices"; category: "Architecture"; selected: current-page == 7; clicked => { root.request-page(7); } }
                            NavigationButton { label: "Playground"; category: "Hands-on Lab"; selected: current-page == 8; clicked => { root.request-page(8); } }
                        }
                    }
                }
            }

            Rectangle {
                background: #ffffff;
                border-radius: 18px;
                border-width: 1px;
                border-color: #d9e2ec;
                HorizontalLayout {
                    padding: 18px;
                    spacing: 18px;
                    VerticalLayout {
                        spacing: 8px;
                        Text { text: page-category; font-size: 14px; font-weight: 700; color: #3b82f6; }
                        Text { text: page-title; font-size: 28px; font-weight: 800; color: #102a43; }
                        Text { text: page-description; wrap: word-wrap; color: #52606d; }
                        Text { text: page-notes; wrap: word-wrap; color: #486581; }
                    }
                    Rectangle {
                        min-width: 220px;
                        background: #f8fafc;
                        border-radius: 14px;
                        border-width: 1px;
                        border-color: #d9e2ec;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 4px;
                            Text { text: "Shell stats"; font-size: 14px; font-weight: 700; color: #334e68; }
                            Text { text: "Pages available: " + total-pages; color: #52606d; }
                            Text { text: dashboard-status-summary; wrap: word-wrap; color: #52606d; }
                        }
                    }
                }
            }
        }

        if current-page == 0 : DashboardPage {
            learner-name: root.learner-name;
            cohort-name: root.cohort-name;
            theme-name: root.theme-name;
            shared-status: root.shared-status;
            status-summary: root.dashboard-status-summary;
            shared-note-text: root.shared-note-text;
            shared-note-status: root.shared-note-status;
            shared-progress-value: root.shared-progress-value;
            shared-progress-label: root.shared-progress-label;
            dashboard-preview-text: root.dashboard-preview-text;
            sync-notes: root.sync-notes;
            request-page(index) => { root.request-page(index); }
            trigger-action(action-id) => { root.dashboard-action(action-id); }
            adjust-progress(delta) => { root.adjust-shared-progress(delta); }
        }
        if current-page == 1 : LayoutsPage {}
        if current-page == 2 : ButtonsAndInputsPage {}
        if current-page == 3 : ListsAndModelsPage {
            rows: root.list-demo-rows;
            selected-index: root.selected-list-demo-index;
            summary: root.list-demo-summary;
            select-item(index) => { root.select-list-demo-item(index); }
            refresh-model => { root.refresh-list-demo(); }
        }
        if current-page == 4 : StylingAndThemesPage {
            theme-options: root.theme-demo-options;
            selected-theme-id: root.theme-demo-selected-id;
            selected-theme-label: root.theme-demo-selected-label;
            selected-theme-summary: root.theme-demo-selected-summary;
            accent-hex: root.theme-demo-accent-hex;
            select-theme(theme-id) => { root.select-theme-demo(theme-id); }
        }
        if current-page == 5 : WindowManagementPage {
            draft-text: root.window-demo-text;
            details-status: root.window-demo-details-status;
            inspector-status: root.window-demo-inspector-status;
            about-status: root.window-demo-about-status;
            child-feedback: root.window-demo-child-feedback;
            lifecycle-status: root.window-demo-lifecycle-status;
            instructional-text: root.window-demo-instructional-text;
            prepared-preview: root.window-demo-prepared-preview;
            update-draft-text(value) => { root.update-window-demo-text(value); }
            open-details-window => { root.open-details-window(); }
            open-inspector-window => { root.open-inspector-window(); }
            hide-inspector-window => { root.hide-inspector-window(); }
            spawn-about-window => { root.spawn-about-window(); }
            close-details-window => { root.close-details-window(); }
            close-all-demo-windows => { root.close-all-demo-windows(); }
        }
        if current-page == 6 : CrossPageDataPage {
            learner-name: root.learner-name;
            cohort-name: root.cohort-name;
            theme-name: root.theme-name;
            shared-status: root.shared-status;
            shared-note-text: root.shared-note-text;
            shared-note-status: root.shared-note-status;
            shared-progress-value: root.shared-progress-value;
            shared-progress-label: root.shared-progress-label;
            dashboard-preview-text: root.dashboard-preview-text;
            editor-hint: root.editor-hint;
            sync-notes: root.sync-notes;
            update-note(value) => { root.update-shared-note(value); }
            adjust-progress(delta) => { root.adjust-shared-progress(delta); }
            reset-demo => { root.reset-cross-page-demo(); }
        }
        if current-page == 7 : PerformanceAndBestPracticesPage {
            pattern-notes: root.performance-pattern-notes;
            component-registry: root.component-registry;
            component-summary: root.component-registry-summary;
            visible-component-count: root.visible-component-count;
        }
        if current-page == 8 : PlaygroundPage {
            rust-show-details: root.playground-show-details;
            rust-loading: root.playground-loading;
            loading-label: root.playground-loading-label;
            toggle-details => { root.toggle-playground-details(); }
            toggle-loading => { root.toggle-playground-loading(); }
        }
    }
}
