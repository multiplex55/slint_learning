import { Button, CheckBox, ComboBox, LineEdit, ScrollView, Slider, SpinBox, Switch } from "std-widgets.slint";

// Widget lesson: this page groups common controls by interaction style so learners can compare
// immediate actions, toggled state, text entry, and constrained numeric input.
// Watch for: which widgets are self-contained examples and which ones would need callbacks if Rust
// had to validate/persist their values.
// Try changing this: turn the slider/progress card into a live binding exercise.
export component ButtonsAndInputsPage inherits Rectangle {
    background: #ffffff;
    border-radius: 16px;

    ScrollView {
        viewport-height: 560px;
        viewport-width: 920px;

        VerticalLayout {
            padding: 18px;
            spacing: 16px;

            Text { text: "This page keeps interactive widgets visible at the same time so learners can compare input styles and outputs."; wrap: word-wrap; color: #52606d; }

            HorizontalLayout {
                spacing: 14px;

                Rectangle {
                    background: #eff6ff;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: #bfdbfe;
                    min-width: 320px;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        Text { text: "Buttons and toggles"; font-size: 20px; font-weight: 800; color: #1d4ed8; }
                        Button { text: "Primary action example"; }
                        CheckBox { text: "Enable helper label"; checked: true; }
                        Switch { text: "Teaching mode switch"; checked: true; }
                        Text { text: "Use this card to discuss event handlers versus simple stateful controls."; wrap: word-wrap; color: #1e3a8a; }
                    }
                }

                Rectangle {
                    background: #f0fdf4;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: #86efac;
                    min-width: 380px;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        Text { text: "Text and selection inputs"; font-size: 20px; font-weight: 800; color: #15803d; }
                        LineEdit { text: "Learner notes go here"; }
                        ComboBox { model: ["Buttons", "Forms", "Validation"]; current-index: 1; }
                        SpinBox { value: 3; minimum: 1; maximum: 10; }
                        Text { text: "Selectors like combo boxes and spin boxes are useful when you want constrained choices."; wrap: word-wrap; color: #166534; }
                    }
                }
            }

            Rectangle {
                background: #fffbeb;
                border-radius: 14px;
                border-width: 1px;
                border-color: #fde68a;
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Text { text: "Slider and progress idea"; font-size: 20px; font-weight: 800; color: #92400e; }
                    Text { text: "Sliders are useful when you want a continuous value. The fill bar below mirrors a static example value for discussion."; wrap: word-wrap; color: #b45309; }
                    slider-demo := Slider { value: 42; minimum: 0; maximum: 100; }
                    Rectangle {
                        height: 18px;
                        background: #fde68a;
                        border-radius: 999px;
                        Rectangle {
                            // Try changing this: replace `0.42` with `slider-demo.value / 100` to
                            // turn this into a real property binding demo.
                            width: parent.width * 0.42;
                            height: parent.height;
                            background: #f59e0b;
                            border-radius: 999px;
                        }
                    }
                }
            }
        }
    }
}
