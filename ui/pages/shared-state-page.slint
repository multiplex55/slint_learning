// Shared-state starter lesson: this compact component is useful when teaching property input
// before introducing callbacks or cross-page synchronization.
// Watch for: Rust-provided string and integer properties displayed directly in Slint.
// Try changing this: replace the count label with a progress bar to practice another binding.
export component SharedStatePage inherits Rectangle {
    in property <string> summary;
    in property <int> completed-topic-count;

    background: #fffaf0;
    border-radius: 12px;

    VerticalLayout {
        padding: 20px;
        spacing: 12px;

        Text {
            text: "Shared application state";
            font-size: 24px;
            font-weight: 700;
            color: #7c2d12;
        }

        Text {
            text: summary;
            wrap: word-wrap;
            color: #9a3412;
        }

        Text {
            text: "Completed topics tracked in Rust: " + completed-topic-count;
            color: #c2410c;
        }
    }
}
