// Generated-code lesson: this small component highlights the "build.rs + include_modules!()"
// workflow without extra interaction details.
// Watch for: Rust passing a plain string property into a reusable Slint component.
// Try changing this: rename the exported component and follow the resulting generated Rust API.
export component GeneratedCodePage inherits Rectangle {
    in property <string> summary;

    background: #f5f3ff;
    border-radius: 12px;

    VerticalLayout {
        padding: 20px;
        spacing: 12px;

        Text {
            text: "Generated code integration";
            font-size: 24px;
            font-weight: 700;
            color: #4c1d95;
        }

        Text {
            text: summary;
            wrap: word-wrap;
            color: #5b21b6;
        }

        Text {
            text: "Look next at build.rs, then compare the exported component names with the Rust API.";
            wrap: word-wrap;
            color: #6d28d9;
        }
    }
}
