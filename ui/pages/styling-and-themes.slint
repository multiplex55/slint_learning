                        padding: 16px;
                        spacing: 8px;
                        Text { text: "Color semantics"; font-size: 20px; font-weight: 800; color: #b91c1c; }
                        Text { text: "Different palettes can represent information, warning, or accent areas without changing the layout."; wrap: word-wrap; color: #991b1b; }
