                }
            }

            HorizontalLayout {
                spacing: 14px;
                Rectangle {
                    background: #eff6ff;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: #bfdbfe;
                    min-width: 280px;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        Text { text: "Card styling"; font-size: 20px; font-weight: 800; color: #1d4ed8; }
                        Text { text: "Rounded corners, subtle borders, and grouped text create a reusable panel pattern."; wrap: word-wrap; color: #1e3a8a; }
                    }
                }
                Rectangle {
                    background: #fef2f2;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: #fecaca;
                    min-width: 280px;
