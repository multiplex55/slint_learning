import { ScrollView } from "std-widgets.slint";
import { ThemeOptionData } from "demo-data.slint";

component ThemeOptionCard inherits Rectangle {
    in property <string> id;
    in property <string> label;
    in property <string> summary;
    in property <string> accent-hex;
    in property <bool> selected;
    callback choose(string);

    min-width: 240px;
    border-radius: 14px;
    border-width: 1px;
    border-color: selected ? #2563eb : #d9e2ec;
    background: selected ? #eff6ff : #f8fafc;

    TouchArea { clicked => { root.choose(root.id); } mouse-cursor: pointer; }

    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        Rectangle { height: 10px; border-radius: 999px; background: selected ? #2563eb : #94a3b8; }
        Text { text: label; font-size: 18px; font-weight: 800; color: #102a43; }
        Text { text: summary; wrap: word-wrap; color: #475569; }
        Text { text: "Accent token: " + accent-hex; color: #64748b; }
    }
}

component ReusableTokenCard inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <string> accent-hex;

    border-radius: 14px;
    border-width: 1px;
    border-color: #d9e2ec;
    background: #ffffff;
    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        Rectangle { height: 8px; border-radius: 999px; background: #2563eb; }
        Text { text: title; font-size: 18px; font-weight: 800; color: #102a43; }
        Text { text: body; wrap: word-wrap; color: #475569; }
    }
}

export component StylingAndThemesPage inherits Rectangle {
    in property <[ThemeOptionData]> theme-options;
    in property <string> selected-theme-id;
    in property <string> selected-theme-label;
    in property <string> selected-theme-summary;
    in property <string> accent-hex;
    callback select-theme(string);

    background: #ffffff;
    border-radius: 16px;

    ScrollView {
        viewport-height: 560px;
        viewport-width: 920px;

        VerticalLayout {
            padding: 18px;
            spacing: 16px;

            Rectangle {
                background: #111827;
                border-radius: 14px;
                min-height: 104px;
                VerticalLayout {
                    padding: 16px;
                    spacing: 6px;
                    Text { text: "Theme-like customization"; font-size: 24px; font-weight: 800; color: white; }
                    Text { text: "Selected theme: " + selected-theme-label; color: #e5e7eb; }
                    Text { text: selected-theme-summary; wrap: word-wrap; color: #cbd5e1; }
                }
            }

            for option in theme-options : ThemeOptionCard {
                id: option.id;
                label: option.label;
                summary: option.summary;
                accent-hex: option.accent_hex;
                selected: option.selected;
                choose(theme-id) => { root.select-theme(theme-id); }
            }

            HorizontalLayout {
                spacing: 14px;
                ReusableTokenCard {
                    title: "Recommended pattern";
                    accent-hex: root.accent-hex;
                    body: "Keep spacing and reusable component structure stable while Rust selects a palette or style variant. That makes theme changes easier to discuss and test.";
                }
                ReusableTokenCard {
                    title: "Less-ideal comparison";
                    accent-hex: "#f59e0b";
                    body: "Editing colors, spacing, and typography inline in every card often hides whether you changed style semantics or layout intent.";
                }
            }

            Rectangle {
                background: #f8fafc;
                border-radius: 14px;
                border-width: 1px;
                border-color: #d9e2ec;
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: "Teaching note"; font-size: 20px; font-weight: 800; color: #102a43; }
                    Text { text: "This repo uses theme-like examples for education. They help explain customization and style variants, but they are not claiming a complete design-token system."; wrap: word-wrap; color: #475569; }
                    Text { text: "Current selection id: " + selected-theme-id; color: #64748b; }
                }
            }
        }
    }
}
