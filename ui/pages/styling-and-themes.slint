                }
            }

            Rectangle {
                background: #fffbeb;
                border-radius: 14px;
                border-width: 1px;
                border-color: #fde68a;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text { text: "Teaching prompt"; font-size: 20px; font-weight: 800; color: #92400e; }
                    Text { text: "Ask learners which parts of this page are style-only and which parts affect layout or behavior."; wrap: word-wrap; color: #b45309; }
                }
